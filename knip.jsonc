// CLI tools and review pages are entrypoints even when they use argv guards.
// Retained player-study adapter: historical review evidence, not a runtime implementation.
// Dynamic browser study exports and approved pixel-math exports remain intentional.
{
  "entry": [
    "playwright.running.config.ts",
    "scripts/assets/build-hill-tileset.mjs",
    "scripts/assets/build-rock-sprites.mjs",
    "scripts/assets/prepare-environment-assets.mjs",
    "scripts/assets/prepare-grove-assets.mjs",
    "scripts/assets/prepare-nest-assets.mjs",
    "scripts/performance/assets.mjs",
    "scripts/performance/build-id.mjs",
    "scripts/performance/capture-transition-reference.mjs",
    "scripts/performance/compare-streaming.mjs",
    "scripts/performance/limiter-analysis.mjs",
    "scripts/performance/manifest.mjs",
    "scripts/performance/optimize.mjs",
    "scripts/performance/reload.mjs",
    "scripts/performance/retention.mjs",
    "scripts/performance/save.mjs",
    "scripts/performance/tables.mjs",
    "scripts/performance/trace-analysis.mjs",
    "scripts/player-art/build-player-final.mjs",
    "scripts/player-art/face-continuity/pack.mjs",
    "scripts/player-art/import-model.mjs",
    "scripts/player-art/import-player-study.mjs",
    "scripts/player-art/prepare-player-remaster.mjs",
    "scripts/player-art/prepare-player-study.mjs",
    "scripts/player-art/report.mjs",
    "scripts/player-flow/analyze-poses.mjs",
    "scripts/player-flow/report.mjs",
    "scripts/player-study/build-report.mjs",
    "scripts/player-study/inspector.ts",
    "scripts/player-study/playwright.config.ts",
    "scripts/player-study/recovery.vite.mjs",
    "scripts/player-study/review.ts",
    "scripts/player-study/vite.config.mjs",
    "scripts/qa/capture-surface-weather.mjs",
    "scripts/qa/capture-world-visibility.mjs",
    "scripts/qa/directional-gallery.mjs",
    "scripts/qa/profile-browser.mjs",
    "scripts/qa/profile-infinite-world.mjs",
    "scripts/qa/profile-landscape.mjs",
    "scripts/qa/profile-surface-weather.mjs",
    "scripts/qa/profile-world-visibility.mjs",
    "src/world/infinite/generation.worker.ts",
  ],
  "project": ["src/**/*.ts", "tests/**/*.ts", "scripts/**/*.{js,mjs,ts}", "*.{js,ts}"],
  "ignoreExportsUsedInFile": {
    "interface": true,
    "type": true,
  },
  "rules": {
    "cycles": "error",
  },
  "ignoreIssues": {
    "src/animation/playerPixelMath.ts": ["exports"],
    "tests/fixtures/player-study.ts": ["exports"],
  },
  "$schema": "./node_modules/knip/schema.json",
  "ignoreBinaries": ["wmctrl"],
  "ignoreFiles": ["scripts/player-study/assets.mjs"],
}
