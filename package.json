{
  "name": "forest-rpg-v2",
  "version": "2.0.0",
  "description": "Standalone modern 2D pixel-art RPG built with TypeScript and PixiJS 8",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "benchmark": "vitest bench --run",
    "sanitize-assets": "node scripts/sanitize-assets.js",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "pixi.js": "^8.6.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@playwright/test": "^1.48.2",
    "@types/node": "^22.8.1",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^9.14.0",
    "happy-dom": "^21.0.4",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.13.0",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0",
    "npm": ">=10.0.0"
  }
}
