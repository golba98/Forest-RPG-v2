{
  "name": "forest-rpg-v2",
  "version": "2.0.0",
  "description": "Standalone modern 2D pixel-art RPG built with TypeScript and PixiJS 8",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "benchmark": "vitest bench --run",
    "sanitize-assets": "node scripts/assets/sanitize-assets.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "profile:build": "VITE_PERF_PROFILE=1 vite build --outDir artifacts/performance/profile-build",
    "profile:fixtures": "node scripts/performance/fixtures.mjs",
    "profile:routes": "node scripts/performance/prepare-routes.mjs",
    "profile:calibrate": "node scripts/performance/calibrate.mjs",
    "profile:scenarios": "node scripts/performance/run.mjs scenarios",
    "profile:stress": "node scripts/performance/run.mjs stress",
    "profile:analyze": "node scripts/performance/analyze.mjs",
    "profile:lab": "node scripts/performance/lab.mjs",
    "profile:trace": "node scripts/performance/trace.mjs",
    "profile:refresh": "node scripts/performance/refresh.mjs",
    "profile:record": "node scripts/performance/record.mjs",
    "profile:report-data": "node scripts/performance/report-data.mjs",
    "profile:cold": "node scripts/performance/cold.mjs",
    "profile:platform": "node scripts/performance/platform.mjs",
    "check:player": "node scripts/regression/approved-player.mjs",
    "test:workflow": "node --test scripts/regression/critical-diff.test.mjs",
    "test:critical": "playwright test --config playwright.critical.config.ts",
    "check:unused": "knip --exclude cycles",
    "check:cycles": "knip --include cycles",
    "test:tooling": "node --test scripts/assets/output-directory.test.mjs scripts/qa/format-changed.test.mjs scripts/performance/statistics.test.mjs",
    "format:changed": "node scripts/qa/format-changed.mjs --write",
    "format:check:changed": "node scripts/qa/format-changed.mjs"
  },
  "dependencies": {
    "pixi.js": "^8.6.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@playwright/test": "^1.48.2",
    "@types/node": "^22.8.1",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^9.14.0",
    "globals": "14.0.0",
    "happy-dom": "^21.0.4",
    "knip": "6.44.2",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.13.0",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0",
    "npm": ">=10.0.0"
  }
}
